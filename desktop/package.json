{
  "name": "bright-ai-desktop",
  "version": "26.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test": "node url-policy.test.js && node config.test.js && node whatsapp-window.test.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.0",
    "playwright": "1.56.1"
  },
  "build": {
    "appId": "com.brightai.desktop",
    "productName": "Bright Ai",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "url-policy.js",
      "config.js",
      "setup.html",
      "setup.js",
      "whatsapp-window.js",
      "local-whatsapp.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "Bright-Ai-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/whatsapp-rust-bridge/**",
      "node_modules/@whiskeysockets/**/prebuilds/**"
    ]
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "9.14.0",
    "qrcode": "1.5.4"
  }
}
